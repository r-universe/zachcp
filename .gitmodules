[submodule ".registry"]
	path = .registry
	url = https://github.com/r-universe-org/cran-to-git
	branch = HEAD
[submodule "fingerprint"]
	path = fingerprint
	url = https://github.com/cran/fingerprint
[submodule "msaR"]
	path = msaR
	url = https://github.com/zachcp/msar
[submodule "phylocanvas"]
	path = phylocanvas
	url = https://github.com/zachcp/phylocanvas
